    @objc private func addTask() {
        guard let title = openTaskEditor(title: "Add Task", initialText: "") else {
            return
        }

        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self else { return }
            do {
                try self.store.addTask(title)
                DispatchQueue.main.async { [weak self] in self?.reloadTasks() }
            } catch {
                let text = self.message(for: error)
                DispatchQueue.main.async { [weak self] in
                    self?.showError("Could not save backlog.md: \(text)")
                }
            }
        }
    }

    @objc private func archiveCompletedTasks() {
        performMutation(errorPrefix: "Could not archive completed tasks") { [store] in
            _ = try store.purgeCompletedTasks()
        }
    }

    @objc private func editSelectedTask() {
        guard let task = selectedActiveTask() else { return }
        openEditor(for: task, draft: task.description)
    }

    @objc private func editClickedTask() {
        let row = tableView.clickedRow
        guard viewMode == .active, tasks.indices.contains(row) else { return }
        let task = tasks[row]
        openEditor(for: task, draft: task.description)
    }

    private func openEditor(for task: BacklogTask, draft: String) {
        guard let title = openTaskEditor(title: "Edit Task", initialText: draft) else { return }
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self else { return }
            do {
                try self.store.updateTask(task: task, title: title)
                DispatchQueue.main.async { [weak self] in
                    self?.reloadTasks(selectingID: task.id)
                }
            } catch {
                let errorText = self.message(for: error)
                let latest = try? self.store.loadTaskLists().active.first { $0.id == task.id }
                DispatchQueue.main.async { [weak self] in
                    guard let self else { return }
                    let latestText = latest.map { "\n\nCurrent text: \($0.description)" } ?? ""
                    self.showError(
                        "Could not save backlog.md: \(errorText)\(latestText)\n\nYour draft will remain open."
                    )
                    self.openEditor(for: latest ?? task, draft: title)
                }
            }
        }
    }

    private func toggleSelectedTaskProgress() {
        guard let task = selectedActiveTask() else { return }
        performMutation(
            errorPrefix: "Could not save backlog.md",
            selectingID: task.id
        ) { [store] in
            try store.toggleTaskProgress(task: task)
        }
    }

    private func moveSelectedTask(offset: Int) {
        guard let task = selectedActiveTask() else { return }
        performMutation(
            errorPrefix: "Could not save backlog.md",
            selectingID: task.id
        ) { [store] in
            try store.moveTask(task: task, offset: offset)
        }
    }

    private func performMutation(
        errorPrefix: String,
        selectingID: String? = nil,
        operation: @escaping () throws -> Void
    ) {
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self else { return }
            do {
                try operation()
                DispatchQueue.main.async { [weak self] in
                    self?.reloadTasks(selectingID: selectingID)
                }
            } catch {
                let text = self.message(for: error)
                DispatchQueue.main.async { [weak self] in
                    self?.showError("\(errorPrefix): \(text)")
                    self?.reloadTasks(selectingID: selectingID)
                }
            }
        }
    }

    private func selectedActiveTask() -> BacklogTask? {
        guard viewMode == .active, tableView.selectedRow >= 0, tasks.indices.contains(tableView.selectedRow) else {
            return nil
        }
        return tasks[tableView.selectedRow]
    }

