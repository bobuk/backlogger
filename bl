def setup():
    prefix = BL_INSTRUCTION[:15]
    candidates = []
    for name in ("AGENTS.md", "CLAUDE.md"):
        if os.path.exists(name):
            candidates.append(name)

    created = []
    if not candidates:
        print("No AGENTS.md or CLAUDE.md found in the current directory.")
        try:
            choice = input("Which file should be created? (agents/claude/none): ").strip().lower()
        except EOFError:
            print("No terminal input available. Run with a TTY or create the file manually.")
            sys.exit(1)
        if choice in ("agents", "a"):
            candidates = ["AGENTS.md"]
            created = ["AGENTS.md"]
        elif choice in ("claude", "c"):
            candidates = ["CLAUDE.md"]
            created = ["CLAUDE.md"]
        else:
            print("Cancelled.")
            return

    for fname in candidates:
        if fname in created:
            lines = []
        else:
            with open(fname, "r", encoding="utf-8") as f:
                lines = f.readlines()

        instructions = [line.rstrip("\r\n") for line in lines if line.startswith(prefix)]
        if instructions == [BL_INSTRUCTION]:
            print(f"Already configured in {fname}")
            continue

        provider = _provider_selection() if lines else None
        plan = None
        if provider:
            try:
                plan = _fetch_setup_assessment(provider, fname, lines)
            except (OSError, ValueError, TypeError, AttributeError, urllib.error.URLError, HTTPException):
                plan = None

        if plan:
            insertion_after = plan["insert_after_line"]
            print(f"LLM assessment for {fname}: {plan['assessment']} existing bl guidance.")
            print(f"Placing the current bl instruction after line {insertion_after}.")
        else:
            insertion_after = _setup_fallback_line(lines)
            if provider:
                print(f"LLM assessment unavailable for {fname}; choosing a local insertion point.")

        removed_before = sum(
            1 for index, line in enumerate(lines, 1)
            if index <= insertion_after and line.startswith(prefix)
        )
        lines = [line for line in lines if not line.startswith(prefix)]
        insertion_after = max(0, min(insertion_after - removed_before, len(lines)))
        if insertion_after and not lines[insertion_after - 1].endswith(("\n", "\r")):
            lines[insertion_after - 1] += "\n"
        lines.insert(insertion_after, BL_INSTRUCTION + "\n")

        with open(fname, "w", encoding="utf-8") as f:
            f.writelines(lines)
        print(f"Updated {fname}")


def _diagnose_backlog(document):
    """Inspect a snapshot without migrating it; stage only unambiguous repairs."""
    repaired = replace(document, active=list(document.active), archive=list(document.archive))
    issues, changes = [], []
    if not document.exists:
        return [("WARN", "backlog.md is missing; use bl add <text> to create it.")], repaired, changes

    for section, lines in (("active", document.active), ("archive", document.archive)):
        for number, line in enumerate(lines, 1):
            if re.match(r"^(?:<{7}|={7}|>{7}|\|{7})(?:\s|$)", line):
                issues.append(("ERROR", f"{section} line {number}: merge conflict marker; resolve the conflict before repairs."))
    if issues:
        return issues, repaired, changes

    tasks = list(_task_locations(document))
    used = {task.task_id for task in tasks if task.task_id}
    seen = set()
    restore = []
    for section, lines in (("active", repaired.active), ("archive", repaired.archive)):
        for index, line in enumerate(lines):
            location = f"{section} line {index + 1}"
            task = parse_task(line)
            if not task:
                if re.match(r"^\s*(?:[-*+]|[0-9]+\.)\s*\[", line):
                    issues.append(("ERROR", f"{location}: malformed task row; expected '- [ ] text #validId'. No automatic repair."))
                continue
            if not task.task_id or task.task_id in seen:
                candidate = _random_id(used)
                used.add(candidate)
                if task.task_id:
                    issues.append(("ERROR", f"{location}: duplicate ID #{task.task_id}."))
                    line = re.sub(r"#[A-Za-z][A-Za-z0-9_-]{2,}(\s*)$", lambda m: f"#{candidate}{m.group(1)}", line)
                    changes.append(f"{location}: replace duplicate #{task.task_id} with #{candidate} (keep the first occurrence).")
                else:
                    issues.append(("WARN", f"{location}: missing a valid final task ID."))
                    line += ("" if line.endswith((" ", "\t")) else " ") + f"#{candidate}"
                    changes.append(f"{location}: append #{candidate}, preserving the task text.")
            if task.task_id:
                seen.add(task.task_id)
            if task.status == "X":
                issues.append(("WARN", f"{location}: noncanonical done status [X]."))
                line = TASK_RE.sub(lambda m: f"{m.group(1)}x{m.group(3)}{m.group(4)}", line, count=1)
                changes.append(f"{location}: normalize [X] to [x].")
            elif task.status not in (STATUS_EMPTY, STATUS_TAKEN, STATUS_DONE):
                hint = "choose bl done/untake <id>" if section == "active" else "archived task needs an explicit status decision"
                issues.append(("ERROR", f"{location}: unknown status {task.status!r}; {hint}. No automatic status change."))
            if not task.description.strip():
                hint = "use bl edit <id> <text>" if section == "active" else "archived task needs an explicit description decision"
                issues.append(("ERROR", f"{location}: empty task description; {hint}."))
            if section == "archive" and task.status in (STATUS_EMPTY, STATUS_TAKEN):
                issues.append(("WARN", f"{location}: unfinished task in archive."))
                restore.append(index)
                changes.append(f"{location}: restore to active tasks, preserving status and ID.")
            lines[index] = line
    if restore:
        repaired.active.extend(repaired.archive[index] for index in restore)
        restored = set(restore)
        repaired.archive = [line for index, line in enumerate(repaired.archive) if index not in restored]
    if not issues:
        active_count = sum(task.section == "active" for task in tasks)
        issues.append(("OK", f"{active_count} active, {len(tasks) - active_count} archived tasks; IDs and statuses are valid."))
    done = sum(task.section == "active" and task.status == STATUS_DONE for task in tasks)
    if done:
        issues.append(("INFO", f"{done} completed active task(s); optionally archive with bl purge."))
    return issues, repaired, changes


def _check_backlog_writable(document):
    target, _ = _backlog_paths()
    if document.exists and not os.access(target, os.W_OK, effective_ids=True):
        raise BacklogError("backlog.md is not writable")
    if not os.access(os.path.dirname(target), os.W_OK | os.X_OK, effective_ids=True):
        raise BacklogError("backlog directory is not writable; atomic repairs need directory access")


def _repair_backlog(expected, repaired):
    # Never hold the lock while asking for confirmation or making network requests.
    with backlog_lock():
        current = _read_document()
        if current != expected:
            raise BacklogError("Backlog changed during diagnosis; run bl doctor --fix again")
        _check_backlog_writable(current)
        _validate_unique_ids(repaired)
        if repaired.render() != current.render():
            _atomic_write(repaired)


def _doctor_setup():
    issues = []
    for name in ("AGENTS.md", "CLAUDE.md"):
        if not os.path.lexists(name):
            continue
        try:
            with open(name, encoding="utf-8") as handle:
                instructions = [line.rstrip("\r\n") for line in handle if line.startswith(BL_INSTRUCTION[:15])]
        except (OSError, UnicodeError):
            issues.append(("ERROR", f"Cannot read {name}; check the file, symlink, permissions, and UTF-8 encoding."))
            continue
        if instructions == [BL_INSTRUCTION]:
            issues.append(("OK", f"{name}: bl instructions are current."))
        else:
            reason = "missing" if not instructions else "outdated or duplicated"
            issues.append(("WARN", f"{name}: bl instructions are {reason}; run bl setup."))
    return issues or [("WARN", "No AGENTS.md or CLAUDE.md; run bl setup to choose and create one.")]


def _doctor_update(offline=False):
    if offline:
        return [("INFO", f"bl {VERSION}: GitHub update check skipped (--offline).")]
    try:
        request = urllib.request.Request(REPO_RAW_URL, headers={"User-Agent": f"bl/{VERSION}"})
        with _no_redirect_opener().open(request, timeout=DOCTOR_TIMEOUT) as response:
            if response.status != 200 or response.geturl() != REPO_RAW_URL:
                raise ValueError("unexpected GitHub response")
            raw = response.read(MAX_UPDATE_RESPONSE + 1)
        if len(raw) > MAX_UPDATE_RESPONSE:
            raise ValueError("GitHub response too large")
        match = re.search(r'''^VERSION\s*=\s*["']([0-9]+\.[0-9]+\.[0-9]+)["']\s*$''', raw.decode("utf-8"), re.MULTILINE)
        if not match:
            raise ValueError("missing version")
        latest = match.group(1)
        remote_version = tuple(map(int, latest.split(".")))
        local_version = tuple(map(int, VERSION.split(".")))
    except (OSError, ValueError, urllib.error.URLError, HTTPException) as exc:
        if isinstance(exc, urllib.error.HTTPError):
            exc.close()
        return [("WARN", f"bl {VERSION}: could not check GitHub (network/response error); update status is unknown.")]
    if remote_version > local_version:
        return [("WARN", f"bl {VERSION} -> {latest} is available on GitHub. Update with:\n    curl -fsSL {REPO_RAW_URL} | python3\n    Then run bl setup. bl install alone only copies the running version.")]
    if remote_version < local_version:
        return [("OK", f"bl {VERSION} is newer than GitHub main ({latest}).")]
    return [("OK", f"bl {VERSION} is up to date with GitHub main.")]


def _doctor_api_error_kind(error):
    """Classify bounded provider error JSON, without exposing its contents."""
    try:
        raw = error.read(MAX_PROVIDER_RESPONSE + 1)
        if len(raw) > MAX_PROVIDER_RESPONSE:
            return None
        data = json.loads(raw)
        detail = data.get("error") if isinstance(data, dict) else None
        if not isinstance(detail, dict):
            return None
        codes = {detail[field] for field in ("code", "type") if isinstance(detail.get(field), str)}
        if codes & {"insufficient_quota", "credit_balance_exhausted", "billing_hard_limit_reached", "insufficient_credits"}:
            return "quota"
        if codes & {"rate_limit_exceeded", "rate_limit_error"}:
            return "rate_limit"
        message = detail.get("message")
        if isinstance(message, str) and any(phrase in message.lower() for phrase in (
            "credit balance is too low", "insufficient credit balance", "credit balance exhausted",
            "insufficient credits", "exceeded your current quota",
        )):
            return "quota"
    except (OSError, ValueError, TypeError, HTTPException):
        pass
    return None


def _doctor_key(provider, offline=False):
    if provider == "openai":
        name, variable, model = "OpenAI", "OPENAI_API_KEY", OPENAI_MODEL
    else:
        name, variable, model = "Claude (Anthropic)", "ANTHROPIC_API_KEY", ANTHROPIC_MODEL
    if not os.environ.get(variable, "").strip():
        return [("WARN", f"{name}: {variable} is not set (optional; IDs can be generated locally).")]
    if offline:
        return [("INFO", f"{name}: {variable} is set; API/balance validation skipped (--offline).")]
    try:
        # Reuse the exact model, token limit, timeout, and request used by bl add.
        # A models-list GET can succeed even when generation credits are exhausted.
        _fetch_provider_candidate(provider, DOCTOR_PROBE_DESCRIPTION)
        return [("OK", f"{name}: {variable} is set; minimal generation with {model} succeeded (quota usable now).")]
    except InvalidProviderCandidate:
        return [(
            "WARN",
            f"{name}: API generation succeeded, but the model did not return a valid 3–8 character ID; "
            "smart IDs will use local random IDs. Key and connectivity are working.",
        )]
    except InvalidProviderResponse:
        return [(
            "WARN",
            f"{name}: API response could not be verified (incomplete, malformed, or unexpected endpoint); "
            "check model/API compatibility and network/proxy settings.",
        )]
    except urllib.error.HTTPError as exc:
        code = exc.code
        try:
            kind = _doctor_api_error_kind(exc) if code in (400, 402, 403, 429) else None
        finally:
            exc.close()
        if kind == "quota":
            return [("ERROR", f"{name}: insufficient balance or exhausted quota (HTTP {code}); top up credits or check billing/usage limits. Smart IDs cannot be generated.")]
        if code == 402:
            return [("ERROR", f"{name}: payment required (HTTP 402); check balance and billing. Smart IDs cannot be generated.")]
        if code == 429:
            reason = "rate limited" if kind == "rate_limit" else "request rejected"
            return [("WARN", f"{name}: {reason} (HTTP 429); balance/quota could not be verified. Retry later; a 429 alone does not prove an empty balance.")]
        if code == 401:
            return [("ERROR", f"{name}: {variable} was rejected (HTTP 401); replace the key.")]
        if code == 403:
            return [("ERROR", f"{name}: API access denied (HTTP 403); check key permissions/account access.")]
        if code in (400, 404):
            return [("ERROR", f"{name}: generation request rejected (HTTP {code}); check model {model} and API settings. Balance could not be verified.")]
        return [("WARN", f"{name}: generation/balance could not be verified (HTTP {code}); retry later.")]
    except (OSError, ValueError, TypeError, AttributeError, urllib.error.URLError, HTTPException):
        # Never print request headers, response bodies, keys, or exception text.
        return [("WARN", f"{name}: generation/balance could not be verified (network/configuration/response error).")]


def _doctor_confirm(prompt, yes=False):
    if yes:
        return True
    if not sys.stdin.isatty():
        print("No terminal confirmation available; rerun with a TTY or --fix --yes.")
        return False
    try:
        return input(f"{prompt} [y/N]: ").strip().lower() in ("y", "yes")
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return False


def doctor(args):
    usage = "Usage: bl doctor [--fix [--yes]] [--offline]"
    if args in (["--help"], ["-h"]):
        print(usage)
        print("Check backlog, GitHub updates, agent instructions, and API keys without changing files.")
        print("--fix      Offer safe backlog repairs and bl setup, each with confirmation.")
        print("--yes      Confirm proposed repairs without prompting (requires --fix).")
        print("--offline  Skip GitHub and provider requests; still report key presence.")
        print("API checks make one tiny, potentially billable generation per configured key (up to 16 output tokens).")
        print("No backlog content is sent. Exhausted balance/quota is an error; plain rate limits are warnings.")
        print("Exit 1 for detected errors; warnings (including unavailable network) do not fail.")
        return 0
    if any(arg not in ("--fix", "--yes", "-y", "--offline") for arg in args):
        raise BacklogError(usage)
    fix, yes, offline = "--fix" in args, bool({"--yes", "-y"} & set(args)), "--offline" in args
    if yes and not fix:
        raise BacklogError("--yes requires --fix. " + usage)

    snapshot, repaired, changes = None, None, []
    try:
        with backlog_lock():
            snapshot = _read_document()
            backlog_issues, repaired, changes = _diagnose_backlog(snapshot)
            try:
                _check_backlog_writable(snapshot)
            except BacklogError as exc:
                backlog_issues.append(("ERROR", str(exc)))
                changes = []
    except BacklogError as exc:
        backlog_issues = [("ERROR", str(exc))]
    setup_issues = _doctor_setup()
    if not offline:
        print("API checks use one tiny generation per configured key (up to 16 output tokens); standard API charges may apply.", flush=True)
    checks = [
        ("Backlog", backlog_issues),
        ("Agent instructions", setup_issues),
        ("Version", _doctor_update(offline)),
        ("API keys", _doctor_key("openai", offline) + _doctor_key("anthropic", offline)),
    ]
    for title, issues in checks:
        print(f"\n{title}:")
        for level, message in issues:
            print(f"  [{level}] {message}")
    if not offline:
        print("\nGeneration probes send fixed test text only, never backlog content. They do not reveal the remaining balance.")
    if changes:
        print("\nProposed backlog repairs (bl doctor --fix):")
        for change in changes:
            print(f"  - {change}")
        if fix and _doctor_confirm("Apply these backlog repairs?", yes):
            try:
                _repair_backlog(snapshot, repaired)
                backlog_issues[:] = _diagnose_backlog(repaired)[0]
                print("Backlog repairs applied atomically.")
            except BacklogError as exc:
                backlog_issues.append(("ERROR", str(exc)))
                print(f"  [ERROR] {exc}")
    if fix and any(level == "WARN" for level, _ in setup_issues):
        if not any(os.path.exists(name) for name in ("AGENTS.md", "CLAUDE.md")):
            print("Run bl setup in a terminal to choose which agent file to create.")
        elif not any(level == "ERROR" for level, _ in setup_issues) and _doctor_confirm("Update agent instructions with bl setup?", yes):
            try:
                setup()
                setup_issues[:] = _doctor_setup()
            except (OSError, UnicodeError):
                setup_issues.append(("ERROR", "bl setup failed; check agent file permissions/encoding."))
                print("  [ERROR] bl setup failed; check agent file permissions/encoding.")
    errors = sum(level == "ERROR" for _, issues in checks for level, _ in issues)
    print(f"\nDoctor finished: {errors} error(s)." + (" No backlog or agent files changed." if not fix else ""))
    return 1 if errors else 0


def unsetup():
    prefix = BL_INSTRUCTION[:15]
    removed = False
    for fname in ("AGENTS.md", "CLAUDE.md"):
        if not os.path.exists(fname):
            continue
        with open(fname, "r", encoding="utf-8") as f:
            lines = f.readlines()
        new_lines = []
        for line in lines:
            if line.rstrip("\n").startswith(prefix):
                removed = True
                continue
            new_lines.append(line)
        if len(new_lines) != len(lines):
            with open(fname, "w", encoding="utf-8") as f:
                f.writelines(new_lines)
            print(f"Removed from {fname}")
    if not removed:
        print("No setup found in AGENTS.md or CLAUDE.md.")


def read_config():
    if not os.path.exists(CONFIG_FILE):
        return {"agent": DEFAULT_AGENT}
    with open(CONFIG_FILE, "rb") as f:
        config = tomllib.load(f)
    if "agent" not in config:
        config["agent"] = DEFAULT_AGENT
    return config


def write_config(config):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        for key, value in config.items():
            if isinstance(value, str):
                f.write(f'{key} = "{value}"\n')
            else:
                f.write(f"{key} = {value}\n")


def show_config():
    config = read_config()
    for key, value in config.items():
        print(f"{key} = {value}")


def config_cmd(args):
    config = read_config()
    if not args:
        show_config()
        return
    key = args[0]
    if key != "agent":
        print(f"Unknown config key: {key}")
        print(f"Available keys: agent ({', '.join(VALID_AGENTS)})")
        sys.exit(1)
    if len(args) == 1:
        print(config.get(key, DEFAULT_AGENT))
        return
    value = args[1]
    if value not in VALID_AGENTS:
        print(f"Invalid agent: {value}")
        print(f"Valid agents: {', '.join(VALID_AGENTS)}")
        sys.exit(1)
    config[key] = value
    write_config(config)
    print(f"Set {key} = {value}")


def run_gui(args):
    """Materialize the embedded Swift app uniquely and bridge it back to this script."""
    if sys.platform != "darwin":
        raise BacklogError("The native GUI is supported only on macOS")
    with tempfile.TemporaryDirectory(prefix="bl-gui-") as temp_dir:
        gui_path = os.path.join(temp_dir, "bl-gui.swift")
        with open(gui_path, "w", encoding="utf-8") as handle:
            handle.write(BL_GUI_SOURCE)
        env = os.environ.copy()
        env["BL_BACKEND_PATH"] = os.path.abspath(__file__)
        env["BL_PYTHON_EXECUTABLE"] = sys.executable
        try:
            result = subprocess.run(["swift", gui_path, *args], env=env)
        except FileNotFoundError:
            raise BacklogError(
                "The GUI needs Swift (install Xcode or the Command Line Tools: xcode-select --install)"
            ) from None
    if result.returncode:
        raise BacklogError(f"The GUI exited with status {result.returncode}")


def _backend_action(action, payload):
    if action == "list":
        return list_tasks(require_exists=bool(payload.get("requireExists", False)))
    if action == "add":
        return add_task(payload.get("text", ""), multiline=True)
    if action == "status":
        return set_task_status(
            payload.get("id", ""),
            payload.get("status", ""),
            expected_status=payload.get("expectedStatus"),
        )
    if action == "purge":
        return purge_tasks()
    if action == "move":
        return move_task(payload.get("id", ""), payload.get("offset", 0))
    if action == "edit":
        return edit_task(
            payload.get("id", ""),
            payload.get("expectedDescription", ""),
            payload.get("description", ""),
        )
    raise BacklogError(f"Unknown backend action: {action}")


def run_backend(action):
    try:
        raw = sys.stdin.read(MAX_PROVIDER_RESPONSE + 1)
        if len(raw) > MAX_PROVIDER_RESPONSE:
            raise BacklogError("Backend request is too large")
        payload = json.loads(raw or "{}")
        if not isinstance(payload, dict):
            raise BacklogError("Backend request must be a JSON object")
        result = _backend_action(action, payload)
        print(json.dumps({"ok": True, "result": result}, ensure_ascii=False))
        return 0
    except (BacklogError, json.JSONDecodeError) as exc:
        message = str(exc) if isinstance(exc, BacklogError) else "Invalid backend JSON"
        print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
        return 1


def run_id_helper(provider):
    try:
        description = sys.stdin.read(MAX_PROVIDER_DESCRIPTION + 1)
        if len(description) > MAX_PROVIDER_DESCRIPTION:
            return 1
        print(_fetch_provider_candidate(provider, description), end="")
        return 0
    except Exception:
        return 1


def run_agent():
    config = read_config()
    agent = config.get("agent", DEFAULT_AGENT)
    match agent:
        case "codex":
            cmd = ["codex", "exec", RUN_PROMPT]
        case "claude":
            cmd = ["claude", "-p", RUN_PROMPT]
        case "pi":
            cmd = ["pi", "-p", RUN_PROMPT]
        case _:
            print(f"Invalid agent in config: {agent}")
            print(f"Valid agents: {', '.join(VALID_AGENTS)}")
            sys.exit(1)

    try:
        result = subprocess.run(cmd)
    except FileNotFoundError:
        print(f"Agent executable not found: {cmd[0]}")
        sys.exit(1)
    sys.exit(result.returncode)


def _self_source():
    """Return the bl source code.

    When bl is run as a normal file we read that file directly. When it is
    piped into the interpreter (e.g. ``cat $(which bl) | python``) there is no
    backing file and stdin is already exhausted, so we fetch the canonical
    copy from the repository instead.
    """
    main_file = getattr(sys.modules["__main__"], "__file__", None)
    if main_file and os.path.exists(main_file):
        with open(main_file, "r", encoding="utf-8") as f:
            return f.read()
    import urllib.request

    try:
        with urllib.request.urlopen(REPO_RAW_URL) as resp:
            return resp.read().decode("utf-8")
    except Exception as exc:
        print(f"Could not fetch bl source from {REPO_RAW_URL}: {exc}")
        sys.exit(1)


def _choose_install_dir():
    # Prefer a common bin dir that's already on PATH so install just works.
    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    for cand in INSTALL_CANDIDATES:
        if cand in path_dirs:
            return cand, True
    return DEFAULT_INSTALL_DIR, False


def install():
    source = _self_source()
    install_dir, on_path = _choose_install_dir()
    install_path = os.path.join(install_dir, "bl")
    os.makedirs(install_dir, exist_ok=True)
    with open(install_path, "w", encoding="utf-8") as f:
        f.write(source)
    os.chmod(install_path, 0o755)
    print(f"Installed bl to {install_path}")
    if not on_path:
        print(f"Note: {install_dir} is not in your PATH.")
        print(f'  Add it with: export PATH="{install_dir}:$PATH"')


def main():
    # When piped into the interpreter there is no real backing file (__file__
    # is None or "<stdin>"), so the only sensible action is to self-install.
    main_file = getattr(sys.modules["__main__"], "__file__", None)
    if main_file is None or not os.path.exists(main_file):
        install()
        return

    args = sys.argv[1:]
    if args and args[0] == "_id-helper":
        if len(args) != 2:
            return 1
        return run_id_helper(args[1])
    if args and args[0] == "_backend":
        if len(args) != 2:
            return 1
        return run_backend(args[1])

    try:
        if not args:
            show()
            return 0
        cmd = args[0]

        if cmd in ("--version", "-V", "version"):
            print(f"bl {VERSION}")
        elif cmd in ("add", "a"):
            text = " ".join(args[1:]) if len(args) > 1 else prompt_for_task()
            if not text:
                print("Cancelled.")
                return 0
            result = add_task(text)
            print(f"Added #{result['id']}: {result['description']}")
        elif cmd in ("take", "t", "untake", "u", "done", "d"):
            if len(args) != 2:
                raise BacklogError(f"Usage: bl {cmd} <id|line_number>")
            status = {
                "take": STATUS_TAKEN,
                "t": STATUS_TAKEN,
                "untake": STATUS_EMPTY,
                "u": STATUS_EMPTY,
                "done": STATUS_DONE,
                "d": STATUS_DONE,
            }[cmd]
            result = set_task_status(args[1], status)
            print(f"Updated #{result['id']} (line {result['lineNumber']})")
        elif cmd in ("available", "v"):
            show_available()
        elif cmd in ("completed", "archive"):
            if len(args) != 1:
                raise BacklogError(f"Usage: bl {cmd}")
            show_completed()
        elif cmd in ("edit", "e"):
            if len(args) < 3:
                raise BacklogError(f"Usage: bl {cmd} <id> <text>")
            result = edit_task(args[1], None, " ".join(args[2:]))
            print(f"Edited #{result['id']}")
        elif cmd in ("move", "m"):
            if len(args) != 3 or args[2].lower() not in ("up", "down"):
                raise BacklogError(f"Usage: bl {cmd} <id> <up|down>")
            offset = -1 if args[2].lower() == "up" else 1
            result = move_task(args[1], offset)
            print(f"Moved #{result['id']} to line {result['lineNumber']}")
        elif cmd in ("gui", "g"):
            run_gui(args[1:])
        elif cmd in ("run", "r"):
            run_agent()
        elif cmd in ("purge", "p"):
            result = purge_tasks()
            if result["count"]:
                print(f"Archived {result['count']} task(s)")
            else:
                print("(no completed tasks to archive)")
        elif cmd == "doctor":
            return doctor(args[1:])
        elif cmd == "setup":
            setup()
        elif cmd == "unsetup":
            unsetup()
        elif cmd == "install":
            install()
        elif cmd == "config":
            config_cmd(args[1:])
        elif cmd in ("help", "-h", "--help"):
            show_help()
        else:
            raise BacklogError(f"Unknown command: {cmd}")
        return 0
    except BacklogError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main() or 0)
