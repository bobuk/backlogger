            string: title,
            attributes: [
                .foregroundColor: NSColor.white,
                .font: NSFont.boldSystemFont(ofSize: 13),
            ]
        )
        button.toolTip = toolTip
        return button
    }

    private func reloadIfNeeded() {
        guard store.currentModificationDate() != lastModificationDate else { return }
        reloadTasks()
    }

    private func reloadTasks(selectingID: String? = nil) {
        reloadGeneration += 1
        let generation = reloadGeneration
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self else { return }
            do {
                let modificationDate = self.store.currentModificationDate()
                let result = try self.store.loadTaskLists()
                DispatchQueue.main.async { [weak self] in
                    guard let self, generation == self.reloadGeneration else { return }
                    self.lastModificationDate = modificationDate
                    if self.viewMode == .completed && result.active.isEmpty {
                        self.tasks = (result.active + result.archive).filter {
                            $0.status.lowercased() == "x"
                        }
                    } else {
                        self.viewMode = .active
                        self.tasks = result.active
                    }
                    self.tableView?.reloadData()
                    self.taskScrollView?.isHidden = self.tasks.isEmpty
                    self.emptyLabel?.isHidden = !self.tasks.isEmpty

                    if let selectingID, let row = self.tasks.firstIndex(where: { $0.id == selectingID }) {
                        self.tableView?.selectRowIndexes(IndexSet(integer: row), byExtendingSelection: false)
                        self.tableView?.scrollRowToVisible(row)
                    }
                }
            } catch {
                let text = self.message(for: error)
                DispatchQueue.main.async { [weak self] in
                    guard let self, generation == self.reloadGeneration else { return }
                    self.showError("Could not load backlog.md: \(text)")
                }
            }
        }
    }

    @objc private func showCompletedTasks() {
        viewMode = .completed
        reloadTasks()
    }

    private func displayStatus(_ status: String) -> String {
        switch status {
        case " ":
            return "⬜"
        case ">":
            return "▶️"
        case "x", "X":
            return "✅"
        default:
            return status
        }
    }

    private func showError(_ message: String) {
        let alert = NSAlert()
        alert.alertStyle = .critical
        alert.messageText = "Error"
        alert.informativeText = message
        alert.runModal()
    }

    private func message(for error: Error) -> String {
        if case BacklogError.message(let message) = error {
            return message
        }
        return error.localizedDescription
    }
}

final class ClosureTarget: NSObject {
    private let closure: () -> Void

    init(_ closure: @escaping () -> Void) {
        self.closure = closure
    }

    @objc func invoke() {
        closure()
    }
}

