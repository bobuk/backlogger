func storeForCurrentDirectory() -> BacklogStore {
    BacklogStore(
        fileURL: URL(fileURLWithPath: FileManager.default.currentDirectoryPath)
            .appendingPathComponent(backlogFileName)
    )
}

func target(from args: [String], command: String) throws -> String {
    guard args.count == 2 else {
        throw BacklogError.message("Usage: bl gui \(command) <id|line_number>")
    }
    return args[1]
}

func printTasks(_ tasks: [BacklogTask]) {
    guard !tasks.isEmpty else {
        print("(backlog is empty)")
        return
    }
    for task in tasks {
        print(String(format: "%3d - [%@] %@", task.lineNumber, task.status, task.title))
    }
}

func commandAction(for args: [String]) -> CommandAction {
    guard !args.isEmpty else {
        return .launchApp
    }

    let command = args[0].lowercased()
    let store = storeForCurrentDirectory()

    do {
        switch command {
        case "add", "a":
            guard args.count > 1 else {
                return .launchApp
            }
            let title = args.dropFirst().joined(separator: " ")
            try store.addTask(title)
            print("Added: \(title)")
            return .exit(0)

        case "take", "t":
            let taskTarget = try target(from: args, command: "take")
            try store.setStatus(target: taskTarget, status: statusTaken)
            print("Updated \(taskTarget)")
            return .exit(0)

        case "untake", "u":
            let taskTarget = try target(from: args, command: "untake")
            try store.setStatus(target: taskTarget, status: statusEmpty)
            print("Updated \(taskTarget)")
            return .exit(0)

        case "done", "d":
            let taskTarget = try target(from: args, command: "done")
            try store.setStatus(target: taskTarget, status: statusDone)
            print("Updated \(taskTarget)")
            return .exit(0)

        case "available", "v":
            let tasks = try store.availableTasks()
            guard !tasks.isEmpty else {
                print("(no available tasks)")
                return .exit(0)
            }
            printTasks(tasks)
            return .exit(0)

        case "purge", "p":
            let count = try store.purgeCompletedTasks()
            guard count > 0 else {
                print("(no completed tasks to archive)")
                return .exit(0)
            }
            print("Archived \(count) task(s)")
            return .exit(0)

        case "show", "ls", "list":
            printTasks(try store.loadActiveTasks())
            return .exit(0)

        case "help", "-h", "--help":
            showHelp()
            return .exit(0)

        case "run", "r", "setup", "unsetup", "install", "config", "doctor":
            print("`bl gui \(command)` is not available. Use `bl \(command)` in the terminal.")
            return .exit(1)

        default:
            print("Unknown command: \(command)\n")
            showHelp()
            return .exit(1)
        }
    } catch BacklogError.message(let message) {
        print(message)
        return .exit(1)
    } catch {
        print("Error: \(error.localizedDescription)")
        return .exit(1)
    }
}

