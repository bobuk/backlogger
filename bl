class BacklogError(Exception):
    """A user-visible operation error that must not commit staged changes."""


TASK_RE = re.compile(r"^(\s*-\s*\[)(.)(\]\s*)(.*)$")
TERMINAL_ID_RE = re.compile(r"(?:^|\s)#([A-Za-z][A-Za-z0-9_-]{2,})\s*$")
GENERATED_ID_RE = re.compile(r"[A-Za-z][A-Za-z0-9_-]{2,7}\Z")


@dataclass
class Task:
    status: str
    description: str
    task_id: str | None
    line_number: int
    section: str


@dataclass
class BacklogDocument:
    active: list[str]
    archive: list[str]
    had_separator: bool
    trailing_newline: bool
    exists: bool
    mode: int = 0o644
    separator_line: str = SEPARATOR
    newline: str = "\n"

    def render(self):
        lines = list(self.active)
        if self.had_separator or self.archive:
            lines.append(self.separator_line)
            lines.extend(self.archive)
        text = self.newline.join(lines)
        if self.trailing_newline and (lines or self.exists):
            text += self.newline
        return text


def parse_task(line, line_number=0, section="active"):
    match = TASK_RE.match(line)
    if not match:
        return None
    raw_description = match.group(4).rstrip()
    id_match = TERMINAL_ID_RE.search(raw_description)
    task_id = id_match.group(1) if id_match else None
    description = raw_description[: id_match.start()].rstrip() if id_match else raw_description
    return Task(match.group(2), description, task_id, line_number, section)


def _backlog_paths():
    target = os.path.realpath(os.path.abspath(BACKLOG))
    return target, os.path.join(os.path.dirname(target), ".backlog.lock")


@contextmanager
def backlog_lock(timeout=LOCK_TIMEOUT):
    if os.name != "posix" or fcntl is None:
        raise BacklogError("bl locking is supported only on macOS and Linux")
    _, lock_path = _backlog_paths()
    try:
        lock_file = open(lock_path, "a+", encoding="utf-8")
    except OSError as exc:
        raise BacklogError(f"Cannot open backlog lock: {exc.strerror or 'filesystem error'}") from None
    deadline = time.monotonic() + timeout
    try:
        while True:
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise BacklogError(
                        f"Timed out waiting for another bl operation ({timeout:g}s)"
                    ) from None
                time.sleep(0.05)
        yield
    finally:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lock_file.close()


def _new_file_mode():
    current_umask = os.umask(0)
    os.umask(current_umask)
    return 0o666 & ~current_umask


def _read_document():
    target, _ = _backlog_paths()
    if not os.path.exists(target):
        return BacklogDocument([], [], False, True, False, _new_file_mode())
    try:
        info = os.stat(target)
        if info.st_nlink > 1:
            raise BacklogError("Refusing to modify a hard-linked backlog.md")
        with open(target, "rb") as handle:
            raw = handle.read()
        text = raw.decode("utf-8")
    except BacklogError:
        raise
    except UnicodeDecodeError:
        raise BacklogError("backlog.md is not valid UTF-8") from None
    except OSError as exc:
        raise BacklogError(f"Cannot read backlog.md: {exc.strerror or 'filesystem error'}") from None

    lines = text.splitlines()
    separator_index = next(
        (index for index, line in enumerate(lines) if line.strip() == SEPARATOR), None
    )
    if separator_index is None:
        active, archive, had_separator = lines, [], False
    else:
        active = lines[:separator_index]
        archive = lines[separator_index + 1 :]
        had_separator = True
    return BacklogDocument(
        active,
        archive,
        had_separator,
        text.endswith(("\n", "\r")),
        True,
        stat.S_IMODE(info.st_mode),
        lines[separator_index] if separator_index is not None else SEPARATOR,
        "\r\n" if "\r\n" in text else "\n",
    )


def _atomic_write(document):
    target, _ = _backlog_paths()
    directory = os.path.dirname(target)
    temp_path = None
    try:
        fd, temp_path = tempfile.mkstemp(prefix=".backlog.", suffix=".tmp", dir=directory)
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
            handle.write(document.render())
            handle.flush()
            os.fchmod(handle.fileno(), document.mode)
            os.fsync(handle.fileno())
        os.replace(temp_path, target)
        temp_path = None
    except OSError as exc:
        raise BacklogError(f"Cannot save backlog.md: {exc.strerror or 'filesystem error'}") from None
    finally:
        if temp_path:
            try:
                os.unlink(temp_path)
            except OSError:
                pass


def _task_locations(document):
    for section_name, lines in (("active", document.active), ("archive", document.archive)):
        for line_number, line in enumerate(lines, start=1):
            task = parse_task(line, line_number, section_name)
            if task:
                yield task


def _validate_unique_ids(document):
    seen = {}
    for task in _task_locations(document):
        if not task.task_id:
            continue
        previous = seen.get(task.task_id)
        if previous:
            raise BacklogError(
                f"Duplicate task ID #{task.task_id}: "
                f"{previous.section} line {previous.line_number} and "
                f"{task.section} line {task.line_number}"
            )
        seen[task.task_id] = task
    return seen


def _random_id(used):
    alphabet = string.ascii_letters + string.digits
    while True:
        length = 5 + secrets.randbelow(2)
        candidate = secrets.choice(string.ascii_letters) + "".join(
            secrets.choice(alphabet) for _ in range(length - 1)
        )
        if candidate not in used:
            return candidate


def _migrate_missing_ids(document, reserved=()):
    existing = _validate_unique_ids(document)
    used = set(existing) | set(reserved)
    changed = False
    for lines in (document.active, document.archive):
        for index, line in enumerate(lines):
            task = parse_task(line)
            if not task or task.task_id:
                continue
            task_id = _random_id(used)
            used.add(task_id)
            separator = "" if line.endswith((" ", "\t")) else " "
            lines[index] = f"{line}{separator}#{task_id}"
            changed = True
    return used, changed


def backlog_transaction(operation, *, create=False, reserved=()):
    with backlog_lock():
        document = _read_document()
        original = document.render()
        used, _ = _migrate_missing_ids(document, reserved)
        result = operation(document, used)
        updated = document.render()
        if updated != original:
            if not document.exists and not create:
                return result
            target, _ = _backlog_paths()
            if document.exists and not os.access(target, os.W_OK, effective_ids=True):
                raise BacklogError("backlog.md is not writable")
            document.exists = True
            document.trailing_newline = True
            _atomic_write(document)
        return result


def _normalize_task_text(text, *, multiline=False):
    if not isinstance(text, str):
        raise BacklogError("Task text must be a string")
    if multiline:
        text = " ".join(text.split())
    elif "\n" in text or "\r" in text:
        raise BacklogError("Task text must fit on one line")
    else:
        text = text.strip()
    if not text:
        raise BacklogError("Task text cannot be empty")
    return text


def _terminal_id(text):
    match = TERMINAL_ID_RE.search(text.rstrip())
    return match.group(1) if match else None


def _description_without_id(text):
    match = TERMINAL_ID_RE.search(text.rstrip())
    return text[: match.start()].rstrip() if match else text.rstrip()


def _provider_selection():
    if os.environ.get("OPENAI_API_KEY", "").strip():
        return "openai"
    if os.environ.get("ANTHROPIC_API_KEY", "").strip():
        return "anthropic"
    return None


def _no_redirect_opener():
    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    return urllib.request.build_opener(NoRedirect)


class InvalidProviderCandidate(ValueError):
    """Provider responded successfully, but its text is not a valid generated ID."""


class InvalidProviderResponse(ValueError):
    """Provider returned a malformed or unusable successful response."""


def _fetch_provider_candidate(provider, description):
    description = description[:MAX_PROVIDER_DESCRIPTION]
    if provider == "openai":
        endpoint = OPENAI_ENDPOINT
        key = os.environ.get("OPENAI_API_KEY", "").strip()
        payload = {
            "model": OPENAI_MODEL,
            "store": False,
            "reasoning": {"effort": "none"},
            "max_output_tokens": 16,
            "input": [
                {"role": "developer", "content": ID_GENERATION_PROMPT},
                {"role": "user", "content": description},
            ],
        }
        headers = {"Authorization": f"Bearer {key}"}
    elif provider == "anthropic":
        endpoint = ANTHROPIC_ENDPOINT
        key = os.environ.get("ANTHROPIC_API_KEY", "").strip()
        payload = {
            "model": ANTHROPIC_MODEL,
            "max_tokens": 16,
            "system": ID_GENERATION_PROMPT,
            "messages": [{"role": "user", "content": description}],
        }
        headers = {"x-api-key": key, "anthropic-version": "2023-06-01"}
    else:
        raise ValueError("unknown provider")

    request = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", **headers},
        method="POST",
    )
    with _no_redirect_opener().open(request, timeout=PROVIDER_TIMEOUT) as response:
        if response.status < 200 or response.status >= 300 or response.geturl() != endpoint:
            raise InvalidProviderResponse("unexpected provider response")
        raw = response.read(MAX_PROVIDER_RESPONSE + 1)
        if len(raw) > MAX_PROVIDER_RESPONSE:
            raise InvalidProviderResponse("provider response too large")
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeError, ValueError) as exc:
        raise InvalidProviderResponse("provider response was not valid JSON") from exc
    if provider == "openai":
        if data.get("status") == "incomplete":
            raise InvalidProviderResponse("incomplete provider response")
        candidates = [
            content.get("text")
            for output in data.get("output", [])
            if output.get("type") == "message"
            for content in output.get("content", [])
            if content.get("type") == "output_text"
        ]
    else:
        candidates = [
            block.get("text")
            for block in data.get("content", [])
            if block.get("type") == "text"
        ]
    if len(candidates) != 1 or not isinstance(candidates[0], str):
        raise InvalidProviderResponse("invalid provider response")
    # Providers often append a final newline despite the output-only instruction;
    # trim boundary whitespace but reject any whitespace within the ID.
    candidate = candidates[0].strip()
    if not GENERATED_ID_RE.fullmatch(candidate):
        raise InvalidProviderCandidate("provider output is not a valid ID")
    return candidate


def _fetch_setup_assessment(provider, filename, lines):
    """Ask the configured provider for a bounded insertion point, not file edits."""
    content = "\n".join(f"{number}: {line.rstrip()}" for number, line in enumerate(lines, 1))
    user_text = (
        f"Required bl policy:\n{BL_INSTRUCTION}\n\n"
        f"Target file: {filename}\n"
        "Existing file lines (numbered):\n"
        f"{content}"
    )
    if len(user_text.encode("utf-8")) > SETUP_MAX_CONTEXT:
        return None

    if provider == "openai":
        endpoint = OPENAI_ENDPOINT
        key = os.environ.get("OPENAI_API_KEY", "").strip()
        payload = {
            "model": OPENAI_MODEL,
            "store": False,
            "reasoning": {"effort": "none"},
            "max_output_tokens": SETUP_MAX_OUTPUT,
            "input": [
                {"role": "developer", "content": SETUP_ASSESSMENT_PROMPT},
                {"role": "user", "content": user_text},
            ],
        }
        headers = {"Authorization": f"Bearer {key}"}
    elif provider == "anthropic":
        endpoint = ANTHROPIC_ENDPOINT
        key = os.environ.get("ANTHROPIC_API_KEY", "").strip()
        payload = {
            "model": ANTHROPIC_MODEL,
            "max_tokens": SETUP_MAX_OUTPUT,
            "system": SETUP_ASSESSMENT_PROMPT,
            "messages": [{"role": "user", "content": user_text}],
        }
        headers = {"x-api-key": key, "anthropic-version": "2023-06-01"}
    else:
        return None

    request = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", **headers},
        method="POST",
    )
    with _no_redirect_opener().open(request, timeout=PROVIDER_TIMEOUT) as response:
        if response.status != 200 or response.geturl() != endpoint:
            return None
        raw = response.read(MAX_PROVIDER_RESPONSE + 1)
    if len(raw) > MAX_PROVIDER_RESPONSE:
        return None
    data = json.loads(raw.decode("utf-8"))
    if provider == "openai":
        if data.get("status") != "completed":
            return None
        texts = [
            item.get("text")
            for output in data.get("output", [])
            if output.get("type") == "message"
            for item in output.get("content", [])
            if item.get("type") == "output_text"
        ]
    else:
        texts = [item.get("text") for item in data.get("content", []) if item.get("type") == "text"]
    if len(texts) != 1 or not isinstance(texts[0], str):
        return None
    result = json.loads(texts[0])
    if not isinstance(result, dict) or set(result) != {"assessment", "insert_after_line"}:
        return None
    assessment = result["assessment"]
    insertion_line = result["insert_after_line"]
    if assessment not in ("none", "partial", "equivalent"):
        return None
    if isinstance(insertion_line, bool) or not isinstance(insertion_line, int):
        return None
    if not 0 <= insertion_line <= len(lines):
        return None
    return {"assessment": assessment, "insert_after_line": insertion_line}


def _setup_fallback_line(lines):
    related = [
        index + 1
        for index, line in enumerate(lines)
        if re.search(r"\b(?:bl|backlog|backlogs|task|tasks)\b", line, re.IGNORECASE)
    ]
    return related[-1] if related else len(lines)


def _semantic_candidate(description):
    provider = _provider_selection()
    if not provider:
        return None
    command = [sys.executable, os.path.abspath(__file__), "_id-helper", provider]
    try:
        result = subprocess.run(
            command,
            input=description,
            text=True,
            capture_output=True,
            timeout=PROVIDER_TIMEOUT + 0.5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    candidate = result.stdout.strip()
    if result.returncode != 0 or not GENERATED_ID_RE.fullmatch(candidate):
        return None
    return candidate


def add_task(text, *, multiline=False):
    text = _normalize_task_text(text, multiline=multiline)
    explicit_id = _terminal_id(text)
    description = _description_without_id(text)
    provider_candidate = None if explicit_id else _semantic_candidate(description)
    candidate = explicit_id or provider_candidate
    if not candidate:
        candidate = _random_id(set())

    def operation(document, used):
        nonlocal candidate
        actual_ids = set(_validate_unique_ids(document))
        if explicit_id and explicit_id in actual_ids:
            raise BacklogError(f"Task ID #{explicit_id} already exists")
        if candidate in actual_ids:
            candidate = _random_id(used)
        if "ASAP" in description or "FIX" in description:
            if any(task.status == STATUS_TAKEN for task in _task_locations(document) if task.section == "active"):
                raise BacklogError("Cannot add a priority task while there are in-progress tasks.")
            document.active.insert(0, f"- [ ] {description} #{candidate}")
        else:
            document.active.append(f"- [ ] {description} #{candidate}")
        return {"id": candidate, "description": description}

    return backlog_transaction(operation, create=True, reserved=(candidate,))


def _find_active_task(document, target):
    target = str(target)
    try:
        line_number = int(target.strip(), 10)
    except ValueError:
        line_number = None
    if line_number is not None:
        if line_number < 1 or line_number > len(document.active):
            raise BacklogError(f"Line {line_number} does not exist (1-{len(document.active)})")
        task = parse_task(document.active[line_number - 1], line_number, "active")
        if not task:
            raise BacklogError(f"Line {line_number} is not a task")
        return task
    for task in _task_locations(document):
        if task.task_id == target:
            if task.section != "active":
                raise BacklogError(f"Task #{target} is archived")
            return task
    raise BacklogError(f"Task ID #{target} was not found")


def set_task_status(target, status, *, expected_status=None):
    if status not in (STATUS_EMPTY, STATUS_TAKEN, STATUS_DONE):
        raise BacklogError("Invalid task status")

    def operation(document, _used):
        if not document.exists:
            raise BacklogError("backlog.md does not exist in the current directory")
        task = _find_active_task(document, target)
        if expected_status is not None and task.status != expected_status:
            raise BacklogError(
                f"Task #{task.task_id} changed from [{expected_status}] to [{task.status}]; refresh and try again"
            )
        if status == STATUS_TAKEN and task.status != STATUS_EMPTY:
            raise BacklogError(f"Task #{task.task_id} is not available (status [{task.status}])")
        index = task.line_number - 1
        document.active[index] = TASK_RE.sub(
            lambda match: f"{match.group(1)}{status}{match.group(3)}{match.group(4)}",
            document.active[index],
            count=1,
        )
        return {"id": task.task_id, "lineNumber": task.line_number, "status": status}

    return backlog_transaction(operation)


def list_tasks(*, require_exists=False):
    def operation(document, _used):
        if require_exists and not document.exists:
            raise BacklogError(
                "backlog.md does not exist in the current directory; use 'bl add <text>' to create it"
            )
        def encode(lines, section):
            tasks = []
            for line_number, line in enumerate(lines, start=1):
                task = parse_task(line, line_number, section)
                if task:
                    tasks.append(
                        {
                            "id": task.task_id,
                            "lineNumber": line_number,
                            "status": task.status,
                            "description": task.description,
                        }
                    )
            return tasks

        return {"active": encode(document.active, "active"), "archive": encode(document.archive, "archive")}

    return backlog_transaction(operation)


def purge_tasks():
    def operation(document, _used):
        if not document.exists:
            raise BacklogError("backlog.md does not exist in the current directory")
        done = [line for line in document.active if (parse_task(line) and parse_task(line).status == STATUS_DONE)]
        if not done:
            return {"count": 0}
        document.active = [line for line in document.active if not (parse_task(line) and parse_task(line).status == STATUS_DONE)]
        document.archive.extend(done)
        document.had_separator = True
        return {"count": len(done)}

    return backlog_transaction(operation)


def move_task(task_id, offset):
    def operation(document, _used):
        task = _find_active_task(document, task_id)
        source = task.line_number - 1
        destination = source + int(offset)
        if destination < 0 or destination >= len(document.active):
            return {"id": task.task_id, "lineNumber": task.line_number}
        line = document.active.pop(source)
        document.active.insert(destination, line)
        return {"id": task.task_id, "lineNumber": destination + 1}

    return backlog_transaction(operation)


def edit_task(task_id, expected_description, new_description):
    new_description = _normalize_task_text(new_description, multiline=True)

    def operation(document, _used):
        task = _find_active_task(document, task_id)
        if expected_description is not None and task.description != expected_description:
            raise BacklogError(
                f"Task #{task_id} was edited elsewhere; your draft was not saved"
            )
        index = task.line_number - 1
        match = TASK_RE.match(document.active[index])
        document.active[index] = (
            f"{match.group(1)}{task.status}{match.group(3)}{new_description} #{task.task_id}"
        )
        return {"id": task.task_id, "description": new_description, "status": task.status}

    return backlog_transaction(operation)


def show_help():
    print(f"""Usage: bl [COMMAND] [ARGS...]

A tiny backlog manager that operates on backlog.md in the current directory.
Version: {VERSION} (2.x backlog format)

Commands:
  bl                         Show active tasks and stable IDs.
  bl add <text>              Add a task; quote an explicit final ID: 'task #login'.
  bl take <id|line>          Atomically claim an available task.
