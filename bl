# Embedded macOS GUI (the bl-gui Swift app). Materialized to a temp
# file and run via `bl gui` so bl stays a single self-contained script.
BL_GUI_SOURCE = r'''#!/usr/bin/env swift

import AppKit

let backlogFileName = "backlog.md"
let separator = "---"
let statusEmpty = " "
let statusTaken = ">"
let statusDone = "x"

enum BacklogError: Error {
    case message(String)
}

enum CommandAction {
    case launchApp
    case exit(Int32)
}

struct BacklogTask {
    let id: String
    let lineNumber: Int
    let status: String
    let description: String

    var title: String { "\(description) #\(id)" }
}

enum TaskViewMode {
    case active
    case completed
}

final class BacklogStore {
    private let fileURL: URL
    private let backendPath: String
    private let pythonPath: String

    init(fileURL: URL) {
        self.fileURL = fileURL
        self.backendPath = ProcessInfo.processInfo.environment["BL_BACKEND_PATH"] ?? ""
        self.pythonPath = ProcessInfo.processInfo.environment["BL_PYTHON_EXECUTABLE"] ?? "/usr/bin/python3"
    }

    func loadActiveTasks() throws -> [BacklogTask] {
        try loadTaskLists().active
    }

    func loadCompletedTasks() throws -> [BacklogTask] {
        let result = try loadTaskLists()
        return (result.active + result.archive).filter { $0.status.lowercased() == "x" }
    }

    func currentModificationDate() -> Date? {
        Self.modificationDate(for: fileURL)
    }

    func addTask(_ title: String) throws {
        _ = try request(action: "add", payload: ["text": title])
    }

    func setStatus(target: String, status: String, expectedStatus: String? = nil) throws {
        var payload: [String: Any] = ["id": target, "status": status]
        if let expectedStatus {
            payload["expectedStatus"] = expectedStatus
        }
        _ = try request(action: "status", payload: payload)
    }

    func availableTasks() throws -> [BacklogTask] {
        try loadTaskLists(requireExists: true).active.filter { $0.status == statusEmpty }
    }

    func purgeCompletedTasks() throws -> Int {
        let result = try request(action: "purge", payload: [:])
        return result["count"] as? Int ?? 0
    }

    func toggleTaskProgress(task: BacklogTask) throws {
        guard task.status == statusEmpty || task.status == statusTaken else { return }
        let nextStatus = task.status == statusTaken ? statusEmpty : statusTaken
        try setStatus(target: task.id, status: nextStatus, expectedStatus: task.status)
    }

    func updateTask(task: BacklogTask, title: String) throws {
        _ = try request(
            action: "edit",
            payload: [
                "id": task.id,
                "expectedDescription": task.description,
                "description": title,
            ]
        )
    }

    func moveTask(task: BacklogTask, offset: Int) throws {
        _ = try request(action: "move", payload: ["id": task.id, "offset": offset])
    }

    func loadTaskLists(requireExists: Bool = false) throws -> (active: [BacklogTask], archive: [BacklogTask]) {
        let result = try request(action: "list", payload: ["requireExists": requireExists])
        return (
            try decodeTasks(result["active"]),
            try decodeTasks(result["archive"])
        )
    }

    private func decodeTasks(_ value: Any?) throws -> [BacklogTask] {
        guard let rows = value as? [[String: Any]] else {
            throw BacklogError.message("Invalid task list from bl backend")
        }
        return try rows.map { row in
            guard
                let id = row["id"] as? String,
                let lineNumber = row["lineNumber"] as? Int,
                let status = row["status"] as? String,
                let description = row["description"] as? String
            else {
                throw BacklogError.message("Invalid task record from bl backend")
            }
            return BacklogTask(
                id: id,
                lineNumber: lineNumber,
                status: status,
                description: description
            )
        }
    }

    private func request(action: String, payload: [String: Any]) throws -> [String: Any] {
        guard !backendPath.isEmpty else {
            throw BacklogError.message("BL_BACKEND_PATH is missing; launch the app with `bl gui`")
        }
        let process = Process()
        process.executableURL = URL(fileURLWithPath: pythonPath)
        process.arguments = [backendPath, "_backend", action]
        process.currentDirectoryURL = URL(fileURLWithPath: FileManager.default.currentDirectoryPath)

        let input = Pipe()
        let output = Pipe()
        process.standardInput = input
        process.standardOutput = output
        process.standardError = FileHandle.nullDevice

        do {
            try process.run()
            let data = try JSONSerialization.data(withJSONObject: payload)
            input.fileHandleForWriting.write(data)
            try input.fileHandleForWriting.close()
            let responseData = output.fileHandleForReading.readDataToEndOfFile()
            process.waitUntilExit()
            guard
                let envelope = try JSONSerialization.jsonObject(with: responseData) as? [String: Any],
                let ok = envelope["ok"] as? Bool
            else {
                throw BacklogError.message("Invalid response from bl backend")
            }
            if !ok {
                throw BacklogError.message(envelope["error"] as? String ?? "bl backend failed")
            }
            guard let result = envelope["result"] as? [String: Any] else {
                throw BacklogError.message("Missing result from bl backend")
            }
            return result
        } catch let error as BacklogError {
            throw error
        } catch {
            throw BacklogError.message("Could not run bl backend: \(error.localizedDescription)")
        }
    }

    private static func modificationDate(for url: URL) -> Date? {
        guard let attrs = try? FileManager.default.attributesOfItem(atPath: url.path) else {
            return nil
        }
        return attrs[.modificationDate] as? Date
    }
}

final class TaskTextView: NSTextView {
    var onCommit: (() -> Void)?
    var onCancel: (() -> Void)?

    override func keyDown(with event: NSEvent) {
        let isCommandA = event.modifierFlags.contains(.command) && event.keyCode == 0
        if isCommandA {
            selectAll(nil)
            return
        }

        let isCommandReturn = event.modifierFlags.contains(.command) && (event.keyCode == 36 || event.keyCode == 76)
        if isCommandReturn {
            onCommit?()
            return
        }

        if event.keyCode == 53 {
            onCancel?()
            return
        }

        super.keyDown(with: event)
    }
}

final class MainWindow: NSWindow {
    var onSpace: (() -> Void)?
    var onEscape: (() -> Void)?
    var onQuit: (() -> Void)?

    override func keyDown(with event: NSEvent) {
        let isPlainSpace = event.charactersIgnoringModifiers == " " && event.modifierFlags.intersection(.deviceIndependentFlagsMask).isEmpty
        if isPlainSpace {
            onSpace?()
            return
        }

        let isCommandQ = event.modifierFlags.contains(.command) && event.keyCode == 12
        if isCommandQ {
            onQuit?()
            return
        }

        if event.keyCode == 53 {
            onEscape?()
            return
        }

        super.keyDown(with: event)
    }
}

